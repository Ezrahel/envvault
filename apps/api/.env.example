# API Server — EnvVault
# Copy to .env.local and fill in values

# ─── Database (optional — falls back to in-memory store if unset) ───
DATABASE_URL=postgres://postgres:postgres@localhost:5432/envvault

# ─── Server ───
PORT=3001
HOST=0.0.0.0

# ─── Logging ───
LOG_LEVEL=info
# NODE_ENV=production

# ─── Cloudflare R2 (optional — falls back to local filesystem storage) ───
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
