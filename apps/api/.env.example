# API Server — EnvVault
# Copy to .env.local and fill in values

# ─── Database: CockroachDB (Postgres-wire compatible) ───
# Local single-node via compose, or CockroachDB Cloud in production:
#   DATABASE_URL=postgresql://<user>:<pass>@<host>:26257/envvault?sslmode=verify-full
# (`cockroachdb://` scheme also accepted.) Unset = in-memory + disk snapshot (dev only).
# REQUIRED in production (NODE_ENV=production fails fast without it).
DATABASE_URL=postgresql://root@localhost:26257/envvault?sslmode=disable

# ─── Server ───
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ─── Logging ───
LOG_LEVEL=info

# ─── Auth (REQUIRED in production, min 32 chars) ───
# Generate: openssl rand -base64 48
JWT_SECRET=
# Optional TTL overrides (seconds). Defaults: access 7d, refresh 30d.
# JWT_ACCESS_TTL_SEC=604800
# JWT_REFRESH_TTL_SEC=2592000

# ─── Browser CORS allowlist (comma-separated). Empty = same-origin/CLI only. ───
# CORS_ORIGINS=http://localhost:3000

# ─── GitHub OAuth (optional — enables real OAuth code exchange) ───
# The OAuth app must request the `user:email` scope: accounts are keyed on the
# user's VERIFIED primary GitHub email (never an email sent by the client).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─── Cloudflare R2 (optional — falls back to local filesystem storage) ───
# All four must be set to activate R2 (production refuses to boot if only some are set).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# ─── Reverse proxy / rate limiting ───
# How many proxy hops to trust for client IPs ("true" = any, "1" = exactly one LB, "false" = exposed directly).
# Wrong value = either spoofable rate limits (too trusting) or every user sharing one IP bucket (too strict).
# TRUST_PROXY=true
# Requests per client IP per minute (global / login+register+refresh).
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=10

# ─── Public base URL of this API (used for local-storage download links) ───
# PUBLIC_API_URL=https://api.example.com

# ─── Single-node snapshot (optional) ───
# Path for the crash-safe JSON snapshot of the in-memory store.
# STORE_SNAPSHOT_PATH=./data/api-store.json
# Set to 1 to disable snapshots (e.g., multi-node behind real Postgres).
# STORE_SNAPSHOT_DISABLED=
