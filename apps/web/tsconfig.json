{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@envvault/shared": ["../../packages/shared/src"],
      "@envvault/ui": ["../../packages/ui/src"]
    }
  },
  "include": ["next-env.d.ts", ".next/types/**/*.ts", "app", "components", "lib"],
  "exclude": ["node_modules"]
}
