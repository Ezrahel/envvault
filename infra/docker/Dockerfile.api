# EnvVault API — production image
# Stress-free: deterministic install, non-root, healthchecked, graceful SIGTERM via node.
FROM node:22-alpine AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
ENV COREPACK_ENABLE_STRICT=0

# 1) Dependency layer (cached unless lockfile changes)
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json tsconfig.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY packages ./packages
# Copy workspace package manifests explicitly for better caching is handled by `packages` above.
RUN pnpm install --frozen-lockfile

# 2) Build
COPY apps/api ./apps/api
RUN pnpm --filter @envvault/api build

# 3) Runtime
ENV NODE_ENV=production \
    PORT=3001 \
    HOST=0.0.0.0
EXPOSE 3001

# Drop privileges — node image ships with `node` user
USER node

# /health returns 200 when ok, /ready returns 503 when DB degraded
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||'3001')+'/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "apps/api/dist/index.js"]
