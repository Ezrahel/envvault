# EnvVault compose deployment — copy to `.env` next to docker-compose.yml
#   cp infra/docker/.env.example infra/docker/.env
#   docker compose -f infra/docker/docker-compose.yml up --build

# REQUIRED — API refuses to boot in production without it (min 32 chars).
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-32-plus-random-chars

# Database — default is local single-node CockroachDB (insecure, dev only).
# Prod (CockroachDB Cloud):
#   DATABASE_URL=postgresql://<user>:<pass>@<free-tier-host>:26257/envvault?sslmode=verify-full
DATABASE_URL=postgresql://root@cockroach:26257/envvault?sslmode=disable
COCKROACH_PORT=26257
COCKROACH_UI_PORT=8080

# Ports
API_PORT=3001
WEB_PORT=3000

# Public API URL baked into the web image at build time
NEXT_PUBLIC_API_URL=http://localhost:3001
# Browser origins allowed to call the API (comma-separated). Empty = same-origin/CLI only.
CORS_ORIGINS=http://localhost:3000

# GitHub OAuth (optional — enables real OAuth code exchange)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare R2 (optional — all four activate it; otherwise local disk under /app/data)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

LOG_LEVEL=info
